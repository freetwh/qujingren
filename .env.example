# 复制为 .env（或 .env.local），填入真实值后重启 Vite/Tauri。
# VITE_* 会在构建时注入前端；请勿把真实密钥提交到 Git。

# OCR：百度智能云控制台创建应用后取得
VITE_OCR_PROVIDER=baidu
VITE_BAIDU_OCR_API_KEY=
VITE_BAIDU_OCR_SECRET_KEY=

# AI 整理（可选）：Kimi 开放平台 platform.moonshot.cn 创建，按 token 计费
# 填 1/true/on 开启；开启后 OCR 文本先由 Kimi 纠错整理，再走规则解析
VITE_AI_REFINE=
VITE_KIMI_API_KEY=
VITE_KIMI_MODEL=moonshot-v1-8k
